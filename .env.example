# OpenAI-compatible API base URL. Do not include /images/generations.
OPENAI_BASE_URL=https://api.openai.com/v1

# Keep the real key only in .env, never in chat or source control.
OPENAI_API_KEY=

# Change this when your provider uses a different image model identifier.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional: generated images are saved here by default.
# OPENAI_IMAGE_OUTPUT_DIR=~/Pictures/Codex Generated Images
